// Grafana Alloy for the optional observability profile (ADR 0016).
//
// Tails Docker's own JSON log files (mounted read-only) instead of using the
// Docker socket, which is root on the host. Sentinel writes one JSON object
// per line (LOG_FORMAT=json), already redacted (ADR 0002); `service` and
// `level` become Loki labels. Other lines are shipped as they are.

local.file_match "containers" {
  path_targets = [{"__path__" = "/var/lib/docker/containers/*/*-json.log", "job" = "docker"}]
  sync_period  = "10s"
}

loki.source.file "containers" {
  targets    = local.file_match.containers.targets
  forward_to = [loki.process.sentinel.receiver]
}

loki.process "sentinel" {
  forward_to = [loki.write.loki.receiver]

  // Docker's wrapper: {"log": "<line>", "stream": "stdout", "time": "..."}
  stage.json {
    expressions = {log = "log", stream = "stream", time = "time"}
  }
  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }
  stage.output {
    source = "log"
  }
  // Sentinel's own structured line. Non-JSON lines simply get no labels.
  stage.json {
    expressions = {service = "service", level = "level"}
  }
  stage.labels {
    values = {service = "", level = "", stream = ""}
  }
  // The file path holds the container ID: high cardinality, keep it out of labels.
  stage.label_drop {
    values = ["filename"]
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
