# Sentinel environment configuration.
# Copy to `.env` (gitignored) and replace every CHANGE_ME value.
#
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Use hex or other URL-safe strings: passwords are embedded in connection URLs.

# --- General ---------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR (DEBUG is rejected in production)
LOG_LEVEL=INFO
# json | console. Empty = console in development, json elsewhere.
LOG_FORMAT=
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted.
# Leave empty unless a proxy sits in front of the API (prod nginx profile).
TRUSTED_PROXIES=
# Comma-separated browser origins allowed to call the API. Never "*".
CORS_ORIGINS=http://localhost:5173

# --- Authentication (docs/adr/0003-identity-sessions-audit.md) -------------
# Secure cookies are sent only over HTTPS (and http://localhost). Set false
# only for local development in Safari; production refuses to start with false.
COOKIE_SECURE=true
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_IDLE_HOURS=12
SESSION_ABSOLUTE_HOURS=24
# Lockout after N consecutive failures; duration doubles per further failure.
LOGIN_MAX_FAILURES=5
LOCKOUT_BASE_SECONDS=60
LOCKOUT_MAX_SECONDS=900
# Login/refresh attempts per client IP per minute. Behind a reverse proxy,
# set TRUSTED_PROXIES or every user shares the proxy's IP (and its limit).
AUTH_RATE_LIMIT_PER_MINUTE=10
# Raise a security alert at N failed logins for one user or IP within the window.
ALERT_FAILED_LOGIN_THRESHOLD=5
ALERT_WINDOW_MINUTES=10

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=sentinel
# Bootstrap superuser. Only the postgres container receives it; the app never does.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# Owns the schema; used only by the one-shot `migrate` container.
SENTINEL_DB_OWNER_PASSWORD=CHANGE_ME
# Least-privilege runtime role used by the api and worker.
SENTINEL_DB_APP_PASSWORD=CHANGE_ME

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Host ports (published on 127.0.0.1 only) -------------------------------
API_PORT=8000
FRONTEND_PORT=5173

# --- Dev ergonomics --------------------------------------------------------
# Docker Desktop bind mounts from Windows/macOS don't emit file events; polling
# makes hot reload work there.
VITE_USE_POLLING=true
WATCHFILES_FORCE_POLLING=true
